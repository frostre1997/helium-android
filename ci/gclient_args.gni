declare_args() {
  # --- Core ---
  build_with_chromium = true
  
  # --- Android (Enable) ---
  checkout_android = true
  checkout_android_native_support = true
  
  # --- Platforms (Disable) ---
  checkout_arc = false
  checkout_chromeos = false
  checkout_cros_sdk = false
  checkout_fuchsia = false
  checkout_ios = false
  checkout_ios_webkit = false
  checkout_mac = false
  checkout_mac_toolchain = false
  checkout_win = false
